package Example4;
import java.util.Scanner;

public class Example4 {
	//ÖKLİD TEOREMİ İLE EBOB BULAN KOD
	public static void GLDLCM(int x, int y) {
                //X VE Y DEĞERLERİ DEĞİŞECEĞİ İÇİN ONLARI SABİT TUTMA AMAÇLI
                //YENİ DEĞİŞKENLERE AKTARIYORUM, EKOK BULMA FORMÜLÜ İÇİN LAZIM OLACAKLAR
		int x2 = x;
		int y2 = y;
		while(y != 0) {
			int mod = x%y;
			x = y;
			y = mod;
		}
		
		System.out.println("GLD(EBOB): " + x + " LCM(EKOK): " + (x2*y2)/x);
	}

	public static void main(String[] args) 
	{
		Scanner scan = new Scanner(System.in);
		System.out.print("Please enter a first number: ");
		int num1 = scan.nextInt();
		
		System.out.print("Please enter a second number: ");
		int num2 = scan.nextInt();
		
		GLDLCM(num1,num2);
	}

}
